# Copy to .env.local for `pnpm dev` (never commit real values).

# PostgreSQL connection string. Matches `docker compose up -d` from compose.yaml.
DATABASE_URL=postgres://novaworks:novaworks@127.0.0.1:5433/novaworks

# OpenRouter API key — server-side only, never exposed to the browser.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Optional: OpenRouter model id and comma-separated fallbacks.
# Defaults: nvidia/nemotron-3-super-120b-a12b:free with free fallbacks.
AI_MODEL=
AI_FALLBACK_MODELS=

# Public URL of the app (sent to OpenRouter as the referring site).
APP_URL=http://localhost:3000
